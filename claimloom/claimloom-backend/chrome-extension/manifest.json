{
  "manifest_version": 3,
  "name": "ClaimLoom Copy Check",
  "version": "1.0.0",
  "description": "Check selected page copy against your ClaimLoom brand rules.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "permissions"
  ],
  "host_permissions": [
    "https://oops-hackathon.onrender.com/*",
    "https://*.onrender.com/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Scan selected copy with ClaimLoom",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
